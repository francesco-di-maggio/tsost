---
import { href, notesOf } from "../course";

// The schedule, from each week's facts: change a week and this follows. Grouped by year like Publications; the week under way is orange.
const weeks = await notesOf("weeks");
const fact = (n: (typeof weeks)[number], key: string) => n.data.facts.find(([k]) => k === key)?.[1] ?? "";
const MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
const rows = weeks.map((n) => {
  const m = fact(n, "Date").match(/(\d{2})\/(\d{2})\/(\d{4})/);
  return { n, iso: m ? `${m[3]}-${m[2]}-${m[1]}` : "", day: m ? `${+m[1]} ${MONTHS[+m[2] - 1]}` : "", year: m ? m[3] : "" };
});
const years = [...new Set(rows.map((r) => r.year))];
---
{years.map((y) => (
  <Fragment>
    <h2 class="label">{y}</h2>
    <div class="panel lists">
      <ul class="list schedule">
        {rows.filter((r) => r.year === y).map((r) => (
          <li data-date={r.iso}><a href={href(r.n)}>
            <span class="text"><b>{r.n.data.title}</b><span class="sub">{[r.day, r.n.data.summary].filter(Boolean).join(" · ")}</span></span>
            <span class="arrow" aria-hidden="true">→</span>
          </a></li>
        ))}
      </ul>
    </div>
  </Fragment>
))}
<script is:inline data-astro-rerun>
  (() => {
    const d = new Date();
    for (const li of document.querySelectorAll(".schedule li[data-date]")) {
      const t = new Date(li.dataset.date);
      li.classList.toggle("on", t <= d && d - t < 7 * 864e5);
    }
  })();
</script>

<style>
  .on b { display: inline-flex; align-items: center; gap: 8px; }
  .on b::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: var(--accent); }
</style>
