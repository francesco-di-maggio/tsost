---
import { dateOf, dayMonth, href, type Note } from "../course";

interface Props { notes: Note[] }
const { notes } = Astro.props;
// On the right, the day a week meets or an assignment is due: "21 Apr".
const when = (n: Note) => { const d = dateOf(n); return d && dayMonth(d); };
---
<div class="panel lists">
  <ul class="list">
    {notes.map((n) => (
      <li><a href={href(n)}>
        <span class="text"><b>{n.data.title}</b><span class="sub">{n.data.summary}</span></span>
        {when(n) ? <span class="label">{when(n)}</span> : <span class="arrow" aria-hidden="true">→</span>}
      </a></li>
    ))}
  </ul>
</div>
