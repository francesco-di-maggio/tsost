---
import type { Item } from "../items";

// One row per item: title with a short line underneath, and one value on the right.
interface Props { items: Item[]; meta?: (i: Item) => string; aside: (i: Item) => string; on?: (i: Item) => boolean }

const { items, meta, aside, on = () => false } = Astro.props;
---
<ul class="list">
  {items.map((i) => (
    <li><a class:list={{ on: on(i) }} href={i.href}>
      <span class="text"><b>{i.title}</b>{meta && <span class="sub">{meta(i)}</span>}</span>
      <span class="label">{aside(i)}</span>
    </a></li>
  ))}
</ul>
