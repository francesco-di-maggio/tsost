---
import "../styles/tokens.css";
import "../styles/site.css";
import { url } from "../url";
import { TYPES, types, itemsOf, sectionPath } from "../items";
import { ClientRouter } from "astro:transitions";

interface Props {
  title?: string;
  description?: string;
}

const { title, description = "Making the invisible audible through tangible and embodied sound interaction. PhD research by Francesco Di Maggio, TU Eindhoven." } = Astro.props;
const pageTitle = title ? `${title} · TSOST` : "TSOST · The Sound of Smart Things";
const path = Astro.url.pathname;
// The nav lists sections; views of the whole (timeline, graph) are icons in the header.
// Course: one live course, so no count.
const nav = await Promise.all((await types()).map(async (t) => ({ path: sectionPath(t), title: TYPES[t].title, ...(t !== "courses" && { count: (await itemsOf(t)).filter((i) => !(i.entry.data as { parent?: string }).parent).length }) })));
const current = (p: string) => (p ? path.startsWith(url(p)) : path === url());
---
<!doctype html>
<html lang="en" transition:animate="none">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#f2f2f0" data-auto="#f2f2f0" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#0b0b0c" data-auto="#0b0b0c" media="(prefers-color-scheme: dark)">
<script is:inline>
  try {
    const theme = localStorage.getItem("theme");
    if (theme === "light" || theme === "dark") document.documentElement.dataset.theme = theme;
  } catch {}
</script>
<title>{pageTitle}</title>
<meta name="description" content={description}>
<link rel="icon" href={url("favicon.svg").replace(/\/$/, "")} type="image/svg+xml">
<link rel="icon" href={url("favicon.png").replace(/\/$/, "")} type="image/png" sizes="32x32">
<link rel="apple-touch-icon" href={url("apple-touch-icon.png").replace(/\/$/, "")}>
<meta property="og:type" content="website">
<meta property="og:title" content={pageTitle}>
<meta property="og:description" content={description}>
<meta property="og:url" content={new URL(path, Astro.site)}>
<meta property="og:image" content={new URL(url("og.png").replace(/\/$/, ""), Astro.site)}>
<meta name="twitter:card" content="summary_large_image">
<ClientRouter />
<!-- Cloudflare Web Analytics: no cookies; one count per page, client-side navigation included. -->
<script is:inline type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "6e2758b8af12449988c12df6253593af"}'></script>
</head>
<body>
<header transition:persist="header">
  <a class="mark" href={url()}><svg viewBox="-9 -9 18 18" aria-hidden="true"><circle class="wave" r="7" /><circle class="ring" r="7" /><circle class="core" r="3" /></svg>TSOST</a>
  <div class="end">
    <button id="header-ping" type="button" hidden>Ping</button>
    <button id="node-status" class="off" type="button" aria-expanded="false" aria-controls="node-panel" title="This browser as a node"><span id="node-status-text">Offline</span></button>
    <a class="icon" href={url("timeline/")} aria-label="Timeline" title="Timeline" aria-current={current("timeline/") ? "page" : undefined}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M3 12h18"/><circle cx="6.5" cy="12" r="2" fill="currentColor"/><circle cx="12" cy="12" r="2" fill="currentColor"/><circle cx="17.5" cy="12" r="2" fill="var(--bg)"/></svg></a>
    <a class="icon" href={url("graph/")} aria-label="Graph" title="Graph" aria-current={current("graph/") ? "page" : undefined}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="6" cy="7" r="2.2"/><circle cx="18" cy="6" r="2.2"/><circle cx="12" cy="18" r="2.2"/><path d="M8 7.5 16 6.4M7 9l4 7M17 8l-4 8"/></svg></a>
    <button id="search-open" class="icon" type="button" aria-label="Search" title="Search (/)" aria-expanded="false" aria-controls="search"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><circle cx="11" cy="11" r="6.5"/><path d="m16 16 4.5 4.5"/></svg></button>
    <button id="theme" type="button" data-state="auto" aria-label="Theme: auto">
      <svg class="auto" width="16" height="16" viewBox="0 0 24 24"><circle cx="12" cy="12" r="8" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M12 4a8 8 0 0 1 0 16z" fill="currentColor"/></svg>
      <svg class="light" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      <svg class="dark" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z"/></svg>
    </button>
  </div>
  <!-- Inline, so the header is right on the first paint: theme icon, breathing phase, and "connecting" when the node reconnects after a reload. -->
  <script is:inline>
    (() => {
      try { document.getElementById("theme").dataset.state = localStorage.getItem("theme") || "auto"; } catch {}
      document.querySelector(".mark .ring").style.animationDelay = `-${Date.now() % 3000}ms`;
      const status = document.getElementById("node-status");
      try {
        if (status.className !== "off" || !localStorage.getItem("tsost-node-on")) return;
        status.className = "busy";
        document.getElementById("node-status-text").textContent = "connecting";
      } catch {}
    })();
  </script>
</header>
<div id="search" class="panel" hidden transition:persist="search">
  <input id="search-input" type="search" placeholder="Search" autocomplete="off" autocapitalize="off" spellcheck="false" enterkeyhint="search" aria-label="Search">
  <ul id="search-results" class="list"></ul>
</div>
<div id="node-panel" class="panel" hidden transition:persist="node-panel">
  <span class="label">Device</span>
  <div class="fields">
    <label class="field"><span class="label">ID</span><input id="node-name" autocapitalize="off" autocorrect="off" spellcheck="false" maxlength="32" enterkeyhint="done"></label>
  </div>
  <div id="node-online">
    <span class="label">Online</span>
    <div id="node-list"></div>
    <a class="control" href={url("graph/")}>Graph<span class="arrow" aria-hidden="true">→</span></a>
  </div>
  <button id="node-connect" class="control" type="button">Connect</button>
</div>
<nav class="label">
  {nav.map((s) => (
    <a href={url(s.path)} aria-current={current(s.path) ? "page" : undefined}>{s.title}{"count" in s && <sup>{s.count}</sup>}</a>
  ))}
</nav>
<main>
  <slot />
</main>
<footer class="label">
  <span>© {new Date().getFullYear()} <a href="https://francescodimaggio.nl/">Francesco Di Maggio</a></span>
  <span class="links">
    <a href="https://www.linkedin.com/in/francesco-di-maggio/" aria-label="LinkedIn" title="LinkedIn"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.125 2.062 2.062 0 0 1 0 4.125zM7.119 20.452H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg></a>
    <a href="https://github.com/francesco-di-maggio" aria-label="GitHub" title="GitHub"><svg viewBox="0 0 16 16" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg></a>
    <a href="mailto:f.di.maggio@tue.nl" aria-label="Email" title="Email"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3.5 6 8.5 7 8.5-7"/></svg></a>
  </span>
</footer>
<script>
  import { start } from "../node";
  import { startSearch } from "../search";

  const THEMES = ["auto", "light", "dark"];
  const THEME_COLOR: Record<string, string> = { light: "#f2f2f0", dark: "#0b0b0c" };
  const button = document.getElementById("theme")!;

  function storedTheme() {
    try { return localStorage.getItem("theme") ?? "auto"; } catch { return "auto"; }
  }

  function applyTheme(theme: string) {
    if (theme === "light" || theme === "dark") document.documentElement.dataset.theme = theme;
    else delete document.documentElement.dataset.theme;
    for (const meta of document.querySelectorAll<HTMLMetaElement>('meta[name="theme-color"]')) {
      meta.content = THEME_COLOR[theme] ?? meta.dataset.auto ?? "";
    }
    button.dataset.state = theme;
    button.setAttribute("aria-label", "Theme: " + theme);
    button.title = "Theme: " + theme;
  }

  applyTheme(storedTheme());

  // The breathing follows the clock, not the page: after navigation it continues where it was.
  function breathe() {
    const ring = document.querySelector<SVGElement>(".mark .ring");
    if (ring) ring.style.animationDelay = `-${Date.now() % 3000}ms`;
  }
  document.addEventListener("astro:after-swap", breathe);
  // Navigation replaces the <html> attributes and the head: apply the theme again.
  document.addEventListener("astro:after-swap", () => applyTheme(storedTheme()));
  button.addEventListener("click", () => {
    const theme = THEMES[(THEMES.indexOf(button.dataset.state ?? "auto") + 1) % THEMES.length];
    applyTheme(theme);
    try { localStorage.setItem("theme", theme); } catch {}
  });
  start();
  startSearch();
</script>
</body>
</html>
