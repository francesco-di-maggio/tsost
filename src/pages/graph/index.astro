---
import Base from "../../layouts/Base.astro";
import Graph from "../../components/Graph.astro";
import { graph } from "../../graph";

const { nodes, edges } = await graph();
---
<Base title="Graph" description="The site as a network: sections, items and the references between them.">
  <h1>Graph</h1>
  <p class="lead">Sections, items and the references between them.</p>
  <Graph nodes={nodes} edges={edges} label="Graph of the site" />
  <p class="hint">Homie 5 on <code>public.cloud.shiftr.io</code>, login <code>public</code>, topic <code>tsost/5/+</code>.</p>
</Base>
