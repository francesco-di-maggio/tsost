---
import Base from "../../layouts/Base.astro";
import { graph, WIDTH, HEIGHT } from "../../graph";

const { nodes, edges } = await graph();
const at = new Map(nodes.map((n) => [n.id, n]));
const R = { project: 9, type: 6, item: 4 };
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---
<Base title="Graph" description="The site as a network: sections, items and the references between them.">
  <h1>Graph</h1>
  <p class="lead">Sections, items and the references between them.</p>
  <div class="panel graph">
    <svg viewBox={`0 0 ${WIDTH} ${HEIGHT}`} role="img" aria-label="Graph of the site">
      {edges.map((e) => {
        const a = at.get(e.a)!, b = at.get(e.b)!;
        return <line class={e.kind} x1={a.x} y1={a.y} x2={b.x} y2={b.y} />;
      })}
      {nodes.map((n) => (
        <a href={n.href} class={n.kind} data-path={n.href.slice(base.length) || "/"} data-x={n.x} data-y={n.y}>
          <circle cx={n.x} cy={n.y} r={R[n.kind]} />
          <text x={n.x + R[n.kind] + 6} y={n.y + 4}>{n.label}</text>
        </a>
      ))}
      <g id="ripples"></g>
      <g id="live"></g>
    </svg>
  </div>
</Base>

<script>
  // Live layer: connected devices as dots around the page each one is on.
  type State = { self: string; list: [string, { path?: string }][]; connected: boolean };
  const NS = "http://www.w3.org/2000/svg";

  function draw() {
    const layer = document.getElementById("live");
    const state = (window as unknown as { tsostDevices?: State }).tsostDevices;
    if (!layer) return;
    layer.replaceChildren();
    if (!state?.connected) return;
    const anchors = [...document.querySelectorAll<SVGAElement>("svg a[data-path]")];
    const at = (path: string) => anchors.find((a) => a.dataset.path === path) ?? anchors.find((a) => a.dataset.path === "/")!;
    const groups = new Map<SVGAElement, string[]>();
    for (const [name, d] of state.list) {
      const a = at(d.path ?? "/");
      groups.set(a, [...(groups.get(a) ?? []), name]);
    }
    for (const [a, names] of groups) {
      const cx = Number(a.dataset.x), cy = Number(a.dataset.y);
      names.forEach((name, i) => {
        // Rings of 8 around the page node.
        const ring = Math.floor(i / 8), angle = (i % 8) * (Math.PI / 4) + ring * 0.4 - Math.PI / 2;
        const r = 16 + ring * 9;
        const dot = document.createElementNS(NS, "circle");
        dot.setAttribute("cx", String(cx + Math.cos(angle) * r));
        dot.setAttribute("cy", String(cy + Math.sin(angle) * r));
        dot.setAttribute("r", "3.5");
        dot.setAttribute("class", name === state.self ? "visitor self" : "visitor");
        dot.dataset.name = name;
        const title = document.createElementNS(NS, "title");
        title.textContent = name;
        dot.append(title);
        layer.append(dot);
      });
    }
  }

  // A ping or a reply spreads from the device's dot like a drop in water.
  function ripple(e: Event) {
    const { kind, device } = (e as CustomEvent<{ kind: string; device: string }>).detail;
    const layer = document.getElementById("ripples");
    const dot = [...document.querySelectorAll<SVGCircleElement>("#live circle.visitor")].find((c) => c.dataset.name === device);
    if (!layer || !dot) return;
    const ring = document.createElementNS(NS, "circle");
    ring.setAttribute("cx", dot.getAttribute("cx")!);
    ring.setAttribute("cy", dot.getAttribute("cy")!);
    ring.setAttribute("r", "4");
    ring.setAttribute("class", `ripple ${kind}`);
    layer.append(ring);
    ring.addEventListener("animationend", () => ring.remove());
  }

  window.addEventListener("tsost:devices", draw);
  window.addEventListener("tsost:signal", ripple);
  document.addEventListener("astro:page-load", draw);
</script>

<style>
  .graph { overflow-x: auto; padding: 8px; }
  svg { display: block; width: 100%; min-width: 560px; height: auto; }
  line.tree { stroke: var(--line); stroke-width: 1; }
  line.ref { stroke: var(--ink); stroke-width: 1.25; }
  circle { fill: var(--surface); stroke: var(--ink); stroke-width: 1.5; }
  .project circle, .type circle { fill: var(--ink); }
  text { font: 500 11px var(--mono); fill: var(--ink); }
  .type text, .project text { letter-spacing: 0.08em; text-transform: uppercase; }
  .item text { fill: var(--dim); }
  a:hover text { fill: var(--ink); text-decoration: underline; }
  a:hover circle { stroke: var(--accent); }
  :global(#live .visitor) { fill: var(--ok); stroke: none; }
  :global(#live .visitor.self) { fill: var(--accent); }
  :global(#ripples .ripple) { fill: none; stroke: var(--ink); stroke-width: 1; transform-box: fill-box; transform-origin: center;
                           animation: ripple 1.2s ease-out forwards; }
  :global(#ripples .ripple.pong) { stroke: var(--ok); }
  @keyframes ripple { from { transform: scale(1); opacity: 0.9; } to { transform: scale(12); opacity: 0; } }
</style>
