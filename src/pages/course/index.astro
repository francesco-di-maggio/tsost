---
import { getEntry, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Facts from "../../components/Facts.astro";
import { SECTIONS, href, notesOf, type Section } from "../../course";

const home = (await getEntry("course", "home"))!;
const { Content } = await render(home);
const sections = await Promise.all(
  (Object.keys(SECTIONS) as Section[]).map(async (s) => ({ title: SECTIONS[s], notes: await notesOf(s) })),
);
---
<Base title="Course" description="The Sound of Smart Things: elective course at TU/e Industrial Design.">
  <span class="label">Course · DCM180</span>
  <h1>{home.data.title}</h1>
  {home.data.facts.length > 0 && <Facts rows={home.data.facts} />}
  <div class="prose body"><Content /></div>
  {sections.filter((s) => s.notes.length).map((s) => (
    <Fragment>
      <h2 class="label">{s.title}</h2>
      <div class="panel lists">
        <ul class="list">
          {s.notes.map((n) => (
            <li><a href={href(n)}><span class="text"><b>{n.data.title}</b></span><span class="arrow" aria-hidden="true">→</span></a></li>
          ))}
        </ul>
      </div>
    </Fragment>
  ))}
</Base>
