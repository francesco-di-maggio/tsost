---
import { getCollection } from "astro:content";
import Base from "../../../layouts/Base.astro";
import Timeline from "../../../components/Timeline.astro";
import { moments } from "../../../course";

// Runs come from the course editions in tsost; weeks and deadlines from the notes.
const runs = (await getCollection("courses")).map((c) => ({ date: c.data.start, end: c.data.end, title: c.data.title, planned: c.data.status === "planned" }));
const list = await moments(runs);
const WEEK = 7 * 864e5;
// From a week before the first moment to ten weeks after the last one, so the next run has room.
const start = new Date(Math.min(...list.map((m) => m.date.valueOf())) - WEEK);
const end = new Date(Math.max(...list.map((m) => m.date.valueOf()), Date.now()) + 10 * WEEK);
---
<Base title="Course timeline" description="The course in time: weeks, deadlines and runs." course>
  <h1>Timeline</h1>
  <p class="lead">Weeks, deadlines and runs.</p>
  <Timeline moments={list} start={start} end={end} scale="week" />
</Base>
