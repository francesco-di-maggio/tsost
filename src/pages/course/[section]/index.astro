---
import Base from "../../../layouts/Base.astro";
import NoteList from "../../../components/NoteList.astro";
import Schedule from "../../../components/Schedule.astro";
import { LEADS, SECTIONS, notesOf, type Section } from "../../../course";

export function getStaticPaths() {
  return (Object.keys(SECTIONS) as Section[]).map((section) => ({ params: { section } }));
}

const s = Astro.params.section as Section;
const list = await notesOf(s);
---
<Base title={SECTIONS[s]} description={LEADS[s]} course>
  <h1>{SECTIONS[s]}</h1>
  <p class="lead">{LEADS[s]}</p>
  {s === "weeks" ? <Schedule /> : <NoteList notes={list} />}
</Base>
