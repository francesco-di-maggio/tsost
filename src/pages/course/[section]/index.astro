---
import Base from "../../../layouts/Base.astro";
import NoteList from "../../../components/NoteList.astro";
import Schedule from "../../../components/Schedule.astro";
import { SECTIONS, notesOf, sections, type Section } from "../../../course";

export function getStaticPaths() {
  return sections.map((section) => ({ params: { section } }));
}

const s = Astro.params.section as Section;
const list = await notesOf(s);
// Every list has a label above it: assignments by the year they are due, the others by group.
const due = (n: (typeof list)[number]) => n.data.facts.find(([k]) => k === "Due")?.[1].match(/\d{4}/)?.[0] ?? "";
const groups = s === "assignments"
  ? [...new Set(list.map(due))].map((y) => ({ label: y, notes: list.filter((n) => due(n) === y) }))
  : [
      ...SECTIONS[s].groups.map((g) => ({ label: g, notes: list.filter((n) => n.data.group === g) })),
      // A note without a known group is still listed.
      { label: "Other", notes: list.filter((n) => !SECTIONS[s].groups.includes(n.data.group ?? "")) },
    ].filter((g) => g.notes.length);
---
<Base title={SECTIONS[s].title} description={SECTIONS[s].lead} course>
  <h1>{SECTIONS[s].title}</h1>
  <p class="lead">{SECTIONS[s].lead}</p>
  {s === "weeks" ? <Schedule /> : groups.map((g) => (
    <Fragment>
      {g.label && <h2 class="label">{g.label}</h2>}
      <NoteList notes={g.notes} />
    </Fragment>
  ))}
</Base>
