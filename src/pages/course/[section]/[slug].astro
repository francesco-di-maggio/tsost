---
import { render } from "astro:content";
import Base from "../../../layouts/Base.astro";
import Facts from "../../../components/Facts.astro";
import { SECTIONS, backlinks, href, notes, notesOf, section, type Note } from "../../../course";
import NoteList from "../../../components/NoteList.astro";
import { url } from "../../../url";

export async function getStaticPaths() {
  return (await notes()).map((n) => {
    const [s, slug] = n.id.split("/");
    return { params: { section: s, slug }, props: { n } };
  });
}

const { n } = Astro.props as { n: Note };
const { Content } = await render(n);
const s = section(n);
// Previous and next within the section: weeks follow each other.
const siblings = await notesOf(s);
const i = siblings.findIndex((x) => x.id === n.id);
const prev = siblings[i - 1], next = siblings[i + 1];
const linked = await backlinks(n);
---
<Base title={n.data.title} description={n.data.summary} course>
  <span class="label"><a class="crumb" href={url(`course/${s}/`)}>{SECTIONS[s]}</a></span>
  <h1>{n.data.title}</h1>
  <p class="lead">{n.data.summary}</p>
  {n.data.facts.length > 0 && <Facts rows={n.data.facts} />}
  {n.data.action && (
    <a class="panel primary" href={n.data.action.href}>
      <span><span class="label">{n.data.action.label}</span><span class="title">{n.data.action.title}</span>{n.data.action.caption && <span class="caption">{n.data.action.caption}</span>}</span>
      <span class="arrow" aria-hidden="true">→</span>
    </a>
  )}
  <div class="prose body"><Content /></div>
  {linked.length > 0 && (
    <Fragment>
      <h2 class="label">Linked from</h2>
      <NoteList notes={linked} />
    </Fragment>
  )}
  {(prev || next) && (
    <div class="pager">
      {prev && <a href={href(prev)}><span class="label"><span aria-hidden="true">←</span> Previous</span><b>{prev.data.title}</b></a>}
      {next && <a href={href(next)}><span class="label">Next <span aria-hidden="true">→</span></span><b>{next.data.title}</b></a>}
    </div>
  )}
</Base>
