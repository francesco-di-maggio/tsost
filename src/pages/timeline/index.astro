---
import Base from "../../layouts/Base.astro";
import Timeline from "../../components/Timeline.astro";
import { TYPES, items } from "../../items";
import { START, END } from "../../project";

// Within the research period: earlier work (modulo, 2023) stays off the axis.
const moments = (await items())
  .filter((i) => i.date && i.date >= START)
  .map((i) => ({ date: i.date!, end: i.end, kind: TYPES[i.type].one, title: i.title, href: i.href }));
---
<Base title="Timeline" description="June 2024 to now, and planned events.">
  <h1>Timeline</h1>
  <p class="lead">June 2024 to now, and planned events.</p>
  <Timeline moments={moments} start={START} end={END} scale="month" startLabel="Start" />
</Base>
