---
import Base from "../../layouts/Base.astro";
import { TYPES, items } from "../../items";
import { START, END } from "../../project";

const MONTH = 36;
const LANE = 72;
const CARD = 190;
const AXIS = 60;

const monthsBetween = (a: Date, b: Date) =>
  (b.getUTCFullYear() - a.getUTCFullYear()) * 12 + b.getUTCMonth() - a.getUTCMonth() + (b.getUTCDate() - 1) / 31;
const origin = new Date(Date.UTC(START.getUTCFullYear(), START.getUTCMonth(), 1));
const x = (d: Date) => Math.round(monthsBetween(origin, d) * MONTH) + 24;
const width = x(END) + CARD + 24;

const dated = (await items()).filter((i) => i.date);

// Oldest first, each card in the lowest lane where it does not overlap the previous card.
const lanes: number[] = [];
const events = [...dated].reverse().map((item) => {
  const left = x(item.date!);
  let lane = lanes.findIndex((right) => right < left);
  if (lane === -1) lane = lanes.length;
  lanes[lane] = left + CARD;
  return { item, left, lane, span: item.end ? x(item.end) - left : 0 };
});
const height = AXIS + (lanes.length + 1) * LANE + 24;

const years: number[] = [];
for (let y = origin.getUTCFullYear() + 1; y <= END.getUTCFullYear(); y++) years.push(y);
const months: Date[] = [];
for (let d = new Date(origin); d <= END; d = new Date(Date.UTC(d.getUTCFullYear(), d.getUTCMonth() + 1, 1))) months.push(d);
const NAMES = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
const now = x(new Date());
const year = (i: number) => dated[i].date!.getUTCFullYear();
---
<Base title="Timeline" description="June 2024 to now, and planned events.">
  <h1>Timeline</h1>
  <p class="lead">June 2024 to now, and planned events.</p>

  <div class="panel tl" data-origin={origin.toISOString()} data-month={MONTH}>
    <div class="track" style={`width:${width}px;height:${height}px`}>
      <div class="axis" style={`bottom:${AXIS}px;width:${x(END) - 24}px`}></div>
      {months.map((m) => (
        <span class:list={["month", { jan: m.getUTCMonth() === 0 }]} style={`left:${x(m)}px;bottom:${AXIS - 22}px`}>{NAMES[m.getUTCMonth()]}</span>
      ))}
      {years.map((y) => (
        <span class="year label" style={`left:${x(new Date(Date.UTC(y, 0, 1)))}px;bottom:${AXIS - 46}px`}>{y}</span>
      ))}
      <span class="start label" style={`left:24px;bottom:${AXIS - 46}px`}>Start</span>
      <div class="now" style={`left:${now}px;bottom:${AXIS - 8}px;height:${height - AXIS - 8}px`}><span class="label">Now</span></div>
      <i class="today" style={`left:${now}px;bottom:${AXIS}px`}></i>
      {events.map(({ item, left, lane, span }) => (
        <Fragment>
          {span > 0 && <div class="span" style={`left:${left}px;width:${span}px;bottom:${AXIS - 2}px`}></div>}
          <div class="stem" style={`left:${left}px;bottom:${AXIS}px;height:${(lane + 1) * LANE - 18}px`}></div>
          <a class="event" href={item.href} style={`left:${left}px;bottom:${AXIS + (lane + 1) * LANE - 18}px;width:${CARD - 14}px`}>
            <span class="label">{item.date!.toISOString().slice(0, 7)} · {TYPES[item.type].one}</span>
            <span class="t">{item.title}</span>
          </a>
          <i class:list={["dot", { planned: item.date! > new Date() }]} style={`left:${left}px;bottom:${AXIS}px`}></i>
        </Fragment>
      ))}
    </div>
  </div>

  <ol class="panel tlv">
    {dated.map((item, i) => (
      <Fragment>
        {(i === 0 || year(i) !== year(i - 1)) && <li class="year label">{year(i)}</li>}
        <li class:list={["ev", { planned: item.date! > new Date() }]} data-date={item.date!.toISOString()}>
          <i class="dot"></i>
          <a href={item.href}>
            <span class="label">{item.date!.toISOString().slice(0, 7)} · {TYPES[item.type].one}</span>
            <span class="t">{item.title}</span>
          </a>
        </li>
      </Fragment>
    ))}
    <li class="ev today-row" hidden><i class="today"></i><span class="label">Now</span></li>
    <li class="ev start"><i class="dot"></i><span class="label">{START.toISOString().slice(0, 7)} · Start</span></li>
  </ol>

</Base>

<script>
  // Today's dot and line are placed in the browser, so they move with the calendar; then "now" is scrolled into view.
  document.addEventListener("astro:page-load", () => {
    const tl = document.querySelector<HTMLElement>(".tl");
    if (!tl) return;
    const origin = new Date(tl.dataset.origin!), d = new Date();
    const months = (d.getUTCFullYear() - origin.getUTCFullYear()) * 12 + d.getUTCMonth() - origin.getUTCMonth() + (d.getUTCDate() - 1) / 31;
    const left = Math.round(months * Number(tl.dataset.month)) + 24;
    for (const el of tl.querySelectorAll<HTMLElement>(".now, .today")) el.style.left = `${left}px`;
    tl.scrollLeft = left - tl.clientWidth * 0.6;

    // Vertical (phones): "now" goes above the newest event that has already happened.
    const past = [...document.querySelectorAll<HTMLElement>(".tlv .ev[data-date]")].find((li) => new Date(li.dataset.date!) <= d);
    const row = document.querySelector<HTMLElement>(".tlv .today-row")!;
    past?.before(row);
    row.hidden = false;
  });
</script>

<style>
  .tl { overflow-x: auto; padding: 0; scrollbar-width: thin; }
  .track { position: relative; }
  .axis { position: absolute; left: 24px; height: 1px; background: var(--dim); }
  .year, .start { position: absolute; }
  .month { position: absolute; padding-left: 3px; border-left: 1px solid var(--line); font: 10px/14px var(--mono); color: var(--dim); }
  .month.jan { border-left-color: var(--dim); color: var(--ink); }
  .now { position: absolute; width: 0; border-left: 1px dashed var(--accent); }
  .now .label { position: absolute; top: -2px; left: 6px; color: var(--accent); }
  .span { position: absolute; height: 5px; border-radius: 3px; background: var(--ink); opacity: 0.35; }
  .stem { position: absolute; width: 1px; background: var(--line); }
  .dot { position: absolute; width: 9px; height: 9px; margin: 0 0 -4px -4px; border-radius: 50%; background: var(--ink); }
  /* Today: the one living dot. */
  .today { position: absolute; z-index: 2; width: 11px; height: 11px; margin: 0 0 -5px -5px; border-radius: 50%; background: var(--accent); }
  .today::after { content: ""; position: absolute; inset: 0; border-radius: 50%; border: 1px solid var(--accent); animation: pulse 2s ease-out infinite; }
  @keyframes pulse { from { transform: scale(1); opacity: 0.8; } to { transform: scale(3); opacity: 0; } }
  .dot.planned { background: var(--surface); border: 1.5px solid var(--ink); }
  .event { position: absolute; z-index: 1; display: block; padding: 0 6px 0 8px; border-left: 1px solid var(--ink);
           background: var(--surface); text-decoration: none; }
  .event .label { display: block; white-space: nowrap; }
  .event .t { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
              font-size: 14px; line-height: 18px; font-weight: 600; }
  .tlv { display: none; margin: 0; padding: 16px 16px 16px 18px; list-style: none; }
  .tlv li { position: relative; padding-left: 22px; border-left: 1px solid var(--dim); }
  .tlv .year { padding-top: 8px; padding-bottom: 4px; color: var(--ink); }
  .tlv .year:first-child { padding-top: 0; }
  .tlv .year::before { content: ""; position: absolute; left: -4px; top: calc(100% - 4px - 0.5lh); width: 7px; height: 1px; background: var(--ink); }
  .tlv .ev { padding-bottom: 14px; }
  .tlv .ev:last-child { padding-bottom: 0; border-left-color: transparent; }
  .tlv .dot { left: 0; top: 4px; margin: 0 0 0 -5px; }
  .tlv .planned .dot { background: var(--surface); border: 1.5px solid var(--ink); }
  .tlv .today { left: 0; top: 2px; margin: 0 0 0 -6px; }
  .tlv .today-row .label { color: var(--accent); }
  .tlv a { display: block; text-decoration: none; }
  .tlv .label { display: block; }
  .tlv .t { display: block; font-size: 15px; line-height: 20px; font-weight: 600; }
  .tlv a:hover .t { text-decoration: underline; text-decoration-color: var(--dim); }
  @media (max-width: 480px) { .tl { display: none; } .tlv { display: block; } }
  .event:hover .t { text-decoration: underline; text-decoration-color: var(--dim); }
</style>
