---
import Base from "../../layouts/Base.astro";
import List from "../../components/List.astro";
import { LAYERS, TYPES, type Layer } from "../../items";
import { part, partsOf } from "../../tesi";
import { url } from "../../url";

// Each component shows what is current or explored; earlier parts fold away, so the page stays short as TESI grows.
const layers = await Promise.all((Object.keys(LAYERS) as Layer[]).map(async (l) => {
  const all = await partsOf(l);
  return { ...LAYERS[l], now: all.filter((p) => part(p).status !== "earlier"), earlier: all.filter((p) => part(p).status === "earlier") };
}));
const status = (p: Parameters<typeof part>[0]) => part(p).status;
---
<Base title="TESI" description={TYPES.tesi.caption}>
  <h1 class="thesis">TESI<span>A modular toolkit for tangible and embodied sound interaction</span></h1>
  <p class="intro">TESI lets interaction designers work with sound in their design context, linking gestures, materials and spatial relationships to sound. <a href={url("publications/tei26-tesi/")}>TEI&nbsp;'26&nbsp;paper</a></p>
  {layers.map((l) => (
    <section class="layer">
      <h2 class="label">{l.title} <span>· {l.caption}</span></h2>
      <div class="panel lists">
        <List items={l.now} meta={(p) => p.summary} aside={status} on={(p) => status(p) === "current"} />
        {l.earlier.length > 0 && (
          <details>
            <summary class="label">Earlier · {l.earlier.length}</summary>
            <List items={l.earlier} meta={(p) => p.summary} aside={status} />
          </details>
        )}
      </div>
    </section>
  ))}
</Base>

<style>
  .intro { margin: 0 0 4px; font-size: 16px; line-height: 1.5; text-wrap: pretty; }
  .layer { display: grid; gap: 8px; margin-top: min(16px, 2vh); }
  .layer h2 { margin: 0; color: var(--ink); }
  .layer h2 span { color: var(--dim); text-transform: none; letter-spacing: 0; font-family: var(--sans); font-size: 14px; }
  details { border-top: 1px solid var(--line); }
  summary { display: flex; align-items: center; min-height: 44px; cursor: pointer; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: "+"; margin-left: auto; font: 400 16px var(--mono); }
  details[open] summary::after { content: "−"; }
  details .list { border-top: 1px solid var(--line); }
</style>
