---
import Base from "../../layouts/Base.astro";
import { LAYERS, TYPES, type Layer } from "../../items";
import { part, partLabel, partsOf } from "../../tesi";

const layers = await Promise.all((Object.keys(LAYERS) as Layer[]).map(async (l) => ({ ...LAYERS[l], parts: await partsOf(l) })));
---
<Base title="TESI" description={TYPES.tesi.caption}>
  <h1 class="thesis">TESI<span>Tangible and Embodied Sound Interaction</span></h1>
  <p class="lead">A modular toolkit, from sensing to sound.</p>
  {layers.map((l) => (
    <section class="layer">
      <h2 class="label">{l.title} <span>· {l.word}</span></h2>
      <p class="caption">{l.caption}</p>
      <ul class="panel parts">
        {l.parts.map((p) => (
          <li><a class:list={{ on: part(p).status === "current" }} href={p.href}>
            <b>{p.title}</b><span class="label">{partLabel(p)}</span>
          </a></li>
        ))}
      </ul>
    </section>
  ))}
</Base>

<style>
  .layer { display: grid; gap: 6px; margin-top: min(16px, 2vh); }
  .layer h2 { margin: 0; color: var(--ink); }
  .layer h2 span { color: var(--dim); }
  .layer .caption { margin: 0 0 4px; }
  .parts { margin: 0; padding: 0 14px; list-style: none; }
  .parts li + li { border-top: 1px solid var(--line); }
  .parts a { display: flex; justify-content: space-between; align-items: center; gap: 12px; min-height: 44px; text-decoration: none; }
  .parts b { font-size: 15px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .parts a:hover b { text-decoration: underline; text-decoration-color: var(--dim); }
  .parts .label { flex: none; display: flex; align-items: center; gap: 6px; }
  .parts .on .label { color: var(--ink); }
  .parts .on .label::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: var(--accent); }
</style>
