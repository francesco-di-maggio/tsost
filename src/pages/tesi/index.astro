---
import Base from "../../layouts/Base.astro";
import { LAYERS, TYPES, type Layer } from "../../items";
import { partsOf } from "../../tesi";
import { url } from "../../url";

const layers = await Promise.all((Object.keys(LAYERS) as Layer[]).map(async (l) => ({ ...LAYERS[l], count: (await partsOf(l)).length })));
---
<Base title="TESI" description={TYPES.tesi.caption}>
  <h1>TESI</h1>
  <p class="lead">Tangible and Embodied Sound Interaction: a modular toolkit in three layers.</p>
  <ul class="rows">
    {layers.map((l) => (
      <li><a class="panel" href={url(`tesi/${l.slug}/`)}>
        <span><span class="label">{l.title} · {l.word} · {l.count}</span><span class="caption">{l.caption}</span></span>
        <span class="arrow">→</span>
      </a></li>
    ))}
  </ul>
</Base>
