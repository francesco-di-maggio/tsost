---
import Base from "../../layouts/Base.astro";
import ItemRow from "../../components/ItemRow.astro";
import { LAYERS, type Layer } from "../../items";
import { part, partLabel, partsOf } from "../../tesi";

export async function getStaticPaths() {
  return (Object.keys(LAYERS) as Layer[]).map((layer) => ({ params: { layer: LAYERS[layer].slug }, props: { layer } }));
}

const { layer } = Astro.props as { layer: Layer };
const { title, word, caption } = LAYERS[layer];
const parts = await partsOf(layer);
---
<Base title={`TESI · ${title}`} description={caption}>
  <span class="label">TESI · {word}</span>
  <h1>{title}</h1>
  <p class="lead">{caption}</p>
  <ul class="rows">
    {parts.map((p) => <ItemRow item={p} on={part(p).status === "current"} label={partLabel(p)} />)}
  </ul>
</Base>
