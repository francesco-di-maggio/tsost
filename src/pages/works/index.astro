---
import Base from "../../layouts/Base.astro";
import List from "../../components/List.astro";
import { TYPES, type Item } from "../../items";
import { byLayer } from "../../works";

const groups = await byLayer();
// As on the personal site: open ranges end in "present".
const years = (i: Item) => {
  if (!i.year) return "";
  if (i.current) return `${i.year}–present`;
  const end = i.end?.getUTCFullYear();
  return end && end !== i.year ? `${i.year}–${end}` : String(i.year);
};
---
<Base title={TYPES.works.title} description={TYPES.works.caption}>
  <h1>{TYPES.works.title}</h1>
  <p class="lead">{TYPES.works.caption}</p>
  {groups.map((g) => (
    <Fragment>
      <h2 class="label">{g.title}</h2>
      <div class="panel lists">
        <List items={g.items} aside={years} on={(i) => i.current} />
      </div>
    </Fragment>
  ))}
</Base>
