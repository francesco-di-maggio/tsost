---
import Base from "../../layouts/Base.astro";
import List from "../../components/List.astro";
import { TYPES, itemsOf, types, type Type } from "../../items";

export async function getStaticPaths() {
  // TESI has its own page: parts by layer.
  return (await types()).filter((t) => t !== "tesi").map((type) => ({ params: { type } }));
}

const type = Astro.params.type as Type;
const { title, caption } = TYPES[type];
const list = await itemsOf(type);
// Publications are grouped by year, newest first; other sections are one list.
const byYear = type === "publications";
const group = (i: (typeof list)[number]) => (i.year ? String(i.year) : "Undated");
const groups = byYear ? [...new Set(list.map(group))] : [""];
const years = list.map((i) => i.year).filter(Boolean) as number[];
const span = byYear && years.length ? ` ${Math.min(...years)}–${Math.max(...years)}` : "";
---
<Base title={title} description={caption}>
  <h1 class="thesis">{title}<span>{caption.replace(/\.$/, "")}{span && `,${span}`}</span></h1>
  {groups.map((g) => (
    <Fragment>
      {g && <h2 class="label">{g}</h2>}
      <div class="panel lists"><List items={g ? list.filter((i) => group(i) === g) : list} label={(i) => i.kind} stacked={byYear} /></div>
    </Fragment>
  ))}
</Base>
