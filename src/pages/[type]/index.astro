---
import Base from "../../layouts/Base.astro";
import List from "../../components/List.astro";
import { TYPES, itemsOf, types, type Type } from "../../items";

export async function getStaticPaths() {
  // TESI has its own page: parts by layer.
  return (await types()).filter((t) => t !== "tesi").map((type) => ({ params: { type } }));
}

const type = Astro.params.type as Type;
const { title, caption } = TYPES[type];
const list = await itemsOf(type);
// Under the title: venue and type for publications, code and status for courses.
const meta = (i: (typeof list)[number]) => {
  const d = i.entry.data as { short?: string; kind?: string; code?: string; status?: string };
  return type === "publications" ? `${d.short} · ${d.kind}` : [d.code, d.status && "Planned"].filter(Boolean).join(" · ");
};
---
<Base title={title} description={caption}>
  <h1 class="thesis">{title}<span>{caption.replace(/\.$/, "")}</span></h1>
  <div class="panel lists"><List items={list} meta={meta} aside={(i) => String(i.year ?? "")} /></div>
</Base>
