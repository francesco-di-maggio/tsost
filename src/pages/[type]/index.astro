---
import Base from "../../layouts/Base.astro";
import List from "../../components/List.astro";
import { TYPES, authors, itemsOf, types, type Type } from "../../items";

export async function getStaticPaths() {
  // TESI has its own page: parts by layer.
  return (await types()).filter((t) => t !== "tesi").map((type) => ({ params: { type } }));
}

const type = Astro.params.type as Type;
const { title, caption } = TYPES[type];
const list = await itemsOf(type);
// Under the title: authors, then venue, place, type and status for publications; year, code and status for courses.
const meta = (i: (typeof list)[number]) => {
  if (i.entry.collection !== "publications") {
    const d = i.entry.data as { code?: string; status?: string };
    return [i.year, d.code, d.status && "Planned"].filter(Boolean).join(" · ");
  }
  const d = i.entry.data;
  const venue = [d.year ? `${d.short} '${String(d.year).slice(2)}` : d.short, d.place].filter(Boolean).join(", ");
  return [authors(d), [venue, d.kind, d.status].filter(Boolean).join(" · ")];
};
---
<Base title={title} description={caption}>
  <h1>{title}</h1>
  <p class="lead">{caption}{type === "publications" && " * Equal contribution."}</p>
  <div class="panel lists"><List items={list} meta={meta} /></div>
</Base>
