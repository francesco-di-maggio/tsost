---
import Base from "../../layouts/Base.astro";
import List from "../../components/List.astro";
import Citation from "../../components/Citation.astro";
import { TYPES, itemsOf, types, type Type } from "../../items";

export async function getStaticPaths() {
  // Works has its own page (by layer); the course is its own site.
  return (await types()).filter((t) => t !== "works" && t !== "courses").map((type) => ({ params: { type } }));
}

const type = Astro.params.type as Type;
const { title, caption } = TYPES[type];
const list = await itemsOf(type);
// Courses: code and status under the title.
const meta = (i: (typeof list)[number]) => {
  const d = i.entry.data as { code?: string; status?: string };
  return [d.code, d.status && "Planned"].filter(Boolean).join(" · ");
};
// Grouped by year, newest first.
const years = [...new Set(list.map((i) => i.year))];
---
<Base title={title} description={caption}>
  <h1>{title}</h1>
  <p class="lead">{caption}</p>
  {years.map((y) => (
    <Fragment>
      <h2 class="label">{y}</h2>
      <div class="panel lists">
        {type === "publications"
          ? <ul class="list">{list.filter((i) => i.year === y).map((i) => <Citation item={i} />)}</ul>
          : <List items={list.filter((i) => i.year === y)} meta={meta} />}
      </div>
    </Fragment>
  ))}
  {type === "publications" && <p class="caption">* Equal contribution.</p>}
</Base>
